modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "vm"
run = ["bash", "-c", "pnpm --filter @workspace/discord-bot run dev & pnpm --filter @workspace/community-bot run dev & wait"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]

[[workflows.workflow]]
name = "typecheck-guard"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/test-typecheck-catches-errors.sh"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000

[nix]
channel = "stable-25_05"
packages = ["noto-fonts-cjk-sans"]

[objectStorage]
defaultBucketID = "replit-objstore-4be7b4fc-42f4-4359-bb92-df3804dde369"

[userenv]

[userenv.shared]
EVAL_SHEET_INTRO_CHANNELS_BY_ROLE = "{\"1526418867335725247\":{\"追放者\":[\"1535330543636320407\",\"1535330581020414093\"]}}"
