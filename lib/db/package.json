{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./sqlite-tools": "./src/sqliteMigration.ts",
    "./sqlite-client": "./src/sqliteClient.ts",
    "./sqlite-backup": "./src/sqliteBackup.ts"
  },
  "scripts": {
    "backup:postgres": "pnpm --filter @workspace/discord-bot exec tsx ../../lib/db/src/exportPostgresCli.ts",
    "sqlite:import": "pnpm --filter @workspace/discord-bot exec tsx ../../lib/db/src/sqliteCli.ts import",
    "sqlite:init": "pnpm --filter @workspace/discord-bot exec tsx ../../lib/db/src/sqliteCli.ts init",
    "push": "drizzle-kit push --config ./drizzle.config.ts",
    "push-force": "drizzle-kit push --force --config ./drizzle.config.ts",
    "migrate:vc-reward-session-key": "pnpm tsx migrate-vc-reward-session-key.ts",
    "migrate:rejoin-log-role-history": "pnpm --filter @workspace/discord-bot exec tsx ../../lib/db/migrate-rejoin-log-role-history.ts",
    "migrate:timed-role-configs": "pnpm --filter @workspace/discord-bot exec tsx ../../lib/db/migrate-timed-role-configs.ts"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "lossless-json": "^4.3.1",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
